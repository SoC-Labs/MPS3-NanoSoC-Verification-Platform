# WAVE-4 tick/hrtimer crash-BISECTION kernel fragment (NOT for production).
#
# Why this exists
# ---------------
# The wave-4 harness image dies in the TICK/CLOCKEVENT/HRTIMER subsystem with
# a garbage callback:
#   * 2026-07-18  hrtimer_interrupt -> epc 0x80000000 (DDR base, unmapped)
#                 "Fatal exception in interrupt", kworker/eval_map_wq @57 s.
#   * earlier     crash PC 0xc0a8b240 == tick_check_broadcast_expired+0x4
#                 (a REAL timer symbol; the first triage misread it as an
#                 "IP-address-shaped" garbage PC — it is not).
# Both are the SAME class: a timer-subsystem object (an hrtimer ->function or
# a clock_event_device / tick device) whose pointer field has been overwritten
# with garbage, then dereferenced from the tick path. That is memory
# corruption by a HARNESS-ONLY component, not an interrupt-routing fault:
#   - the soclabs-mbv-timer clockevent (0003) and the uartlite In1 scrub (0004)
#     were audited and are sound; both scrub only their OWN node's hwirq;
#   - the linux_soc kernel config is byte-identical EXCEPT CONFIG_SMSC911X
#     (harness=y, linux_soc=n) — i.e. the eth driver is a harness-only delta;
#   - the mps3_dfx.ko out-of-tree module is the other harness-only delta.
#
# This fragment turns the mystery garbage-callback panic into a NAMED culprit
# with a stack trace, so the next board window pins the corruptor in one boot.
#
# DEBUG_OBJECTS_TIMERS is the load-bearing one: it validates every timer_list
# and hrtimer at init/start/free/expiry and screams (with the offending
# driver's stack) the instant a timer object is corrupted, freed-while-armed,
# or used uninitialised. SLUB_DEBUG_ON + DEBUG_LIST + DEBUG_VM catch the
# adjacent heap overflow (e.g. an smsc911x RX over-read) at the next slab op.
#
# REVERT once the corruptor is found (do NOT ship a production image with
# these — they add real runtime overhead and grow the kernel).

CONFIG_DEBUG_KERNEL=y
CONFIG_DEBUG_OBJECTS=y
CONFIG_DEBUG_OBJECTS_ENABLE_DEFAULT=1
CONFIG_DEBUG_OBJECTS_FREE=y
CONFIG_DEBUG_OBJECTS_TIMERS=y
CONFIG_DEBUG_OBJECTS_WORK=y
CONFIG_DEBUG_OBJECTS_RCU_HEAD=y
CONFIG_DEBUG_LIST=y
CONFIG_SLUB_DEBUG=y
CONFIG_SLUB_DEBUG_ON=y
CONFIG_DEBUG_VM=y

# WAVE-4 eth0 diagnosis (2026-07-19): make the kernel report the blocked task itself.
# `ip link set eth0 up` blocks inside phy_connect_direct(); SysRq-over-serial is
# unavailable on uartlite and the shell wedges, so let the hung-task detector print
# the stack automatically after 30s.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=30
CONFIG_STACKTRACE=y
