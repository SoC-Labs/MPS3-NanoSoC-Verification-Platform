# Harness kernel fragment — merged AFTER the proven linux_soc fragment
# (uartlite/intc/earlycon, the soclabs-mbv timer) on top of rv32_defconfig.
# The DTB decides what probes (src/linux_harness/shell_linux.dts, GENERATED by
# tools/gen_dts.py). On qemu-virt none of the Xilinx/SMSC devices exist and
# these drivers stay idle.
#
# THE OWNERSHIP RULE (LINUX_HARNESS_PLAN §3, IMAGE_CONTRACT §9): a block is
# kernel-owned (its driver below) or harnessd-owned (a generic-uio node and NO
# kernel driver). The DTS is the primary guard — a harnessd node's only
# compatible is "generic-uio" — and the "not set" lines at the bottom are the
# second: a driver that could bind a harnessd block is not even built.

# Ethernet (LAN9220 on AXI EMC) — kernel-owned eth0
CONFIG_NETDEVICES=y
CONFIG_NET_VENDOR_SMSC=y
CONFIG_SMSC911X=y
CONFIG_SMSC_PHY=y

# WireGuard tunnel (OOB mgmt over eth0). CONFIG_WIREGUARD `select`s its own
# crypto; `select` is silent, so the BUILT .config must be grepped for
# CONFIG_WIREGUARD=y after a build (build.sh does).
CONFIG_WIREGUARD=y
CONFIG_NET_UDP_TUNNEL=y
CONFIG_CRYPTO=y

# User microSD (D13's usd_spi, kernel-owned): the out-of-tree spi-usd.ko
# controller (br2_external package mps3-spi-usd) + the stock mmc_spi slot.
# GPIOLIB: spi-usd is also the slot's card-detect gpio chip. OVERLAY_FS: the
# /etc/mps3 overlay on /persist (S12mps3persist).
CONFIG_SPI=y
CONFIG_SPI_MASTER=y
CONFIG_GPIOLIB=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_SPI=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y

# UIO estate: every harnessd-owned block binds uio_pdrv_genirq via the DTS
# bootarg uio_pdrv_genirq.of_id=generic-uio (load-bearing)
CONFIG_UIO=y
CONFIG_UIO_PDRV_GENIRQ=y

# ramoops/pstore @ top MiB of DDR (S15pstore)
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_MAGIC_SYSRQ=y

# regulator-fixed for the LAN9220 supply stubs
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# --- THE FROZEN CLOCK (B1 silicon 2026-09-24, BOOT lane) ---------------------
# On MicroBlaze V the `time` CSR IS mcycle: `csrw mcycle` reads straight back
# through rdtime, and mcountinhibit.CY freezes both (xsim on the vendor RTL,
# microblaze_riscv 2026.1 rev 9 + 2025.2 rev 7; only CY and IR are inhibitable).
# riscv-pmu-sbi's CPU-starting callback calls SBI PMU COUNTER_STOP on every
# counter; OpenSBI 1.6 answers by setting mcountinhibit.CY, so rdtime ->
# sched_clock (printk time, the CFS clock), get_cycles() and
# random_get_entropy() stop for good ~24 s into boot. The crng then never
# initialises (try_to_generate_entropy() needs a moving counter), the first
# blocking getrandom() -- S12mps3persist's dropbearkey -- never returns, and
# stage0's WDOG restarts the board before harnessd starts. Every July silicon
# boot froze at the same printk. mps3_image.py kconfig-gate refuses =y.
# CONFIG_RISCV_PMU_SBI is not set

# --- BOOT BUDGET: stage0's WDOG is 42.9 s from the jump to harnessd's first kick
# The EMBEDDED rootfs goes in UNCOMPRESSED. Inflating the 12.8 MB gzip cpio is
# ~12 s of CPU at ~31 MIPS (QEMU icount model), about twice that on the MBV,
# run as an async worker that competes with every initcall on the one hart;
# and every request_module() (the smsc911x PHY probe's) blocks in
# wait_for_initramfs() until it ends -- the 15.2 -> 24.0 s gap on silicon.
# Cost: Image ~+6.5 MB (still MiBs below the 0x82200000 DTB slot; build.sh
# step 7 gates it), slot image ~31 MB of the 64 MiB stage0 slot, TFTP push
# ~+12 s (before stage0 arms the WDOG). mps3_image.py kconfig-gate requires it.
# The compression choice only EXISTS while INITRAMFS_SOURCE is non-empty, and
# Buildroot sets INITRAMFS_SOURCE after the fragments are merged -- so without
# the SOURCE line below the merge drops NONE and the fixup's olddefconfig picks
# GZIP again (the first b1_v3 build did; the gate caught it). The value is the
# one Buildroot writes itself (linux.mk, BR2_TARGET_ROOTFS_INITRAMFS).
CONFIG_INITRAMFS_SOURCE="${BR_BINARIES_DIR}/rootfs.cpio"
# CONFIG_INITRAMFS_COMPRESSION_GZIP is not set
CONFIG_INITRAMFS_COMPRESSION_NONE=y
# 256 legacy BSD pty pairs = 512 device nodes at pty_init (0.8 s of CPU in the
# model, ~6 s when it interleaves with the gzip unpack -- most of the 3.3 ->
# 14.0 s gap). dropbear and getty use Unix98 /dev/pts (UNIX98_PTYS stays =y).
# CONFIG_LEGACY_PTYS is not set
# No ftrace: with the gzip unpack gone, the next CPU sink before /init is the
# trace eval-map rewrite (trace_eval_init queues it on eval_map_wq at ~0.3 s;
# the late initcall trace_eval_sync then WAITED 1.8 s for it in the model --
# ~3.5 s on the MBV, on the critical path to harnessd). Nothing in the harness
# uses tracefs or ftrace. (July's "kworker/eval_map_wq" crash sat on it too.)
# CONFIG_FTRACE is not set

# --- QEMU proof helpers ------------------------------------------------------
# virtio-net + virtio-blk for boot_qemu_harness.sh (rv32_defconfig carries
# them; pinned so the proof can never silently lose its NIC or its /persist).
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y

# --- NOT built: drivers that could bind a harnessd-owned block ---------------
# WDOG: harnessd arms and kicks the axi_timebase_wdt (HARNESSD_CONTRACT §5.3).
# CONFIG_WATCHDOG is not set
# HWICAP: harnessd's swap_fsm drives ICAP through UIO (DL6).
# CONFIG_XILINX_HWICAP is not set
# MMCM_DRP: harnessd's clkrst does the PG065 DRP sequence.
# CONFIG_COMMON_CLK_XLNX_CLKWZRD is not set
# TOUCH (AXI IIC): harnessd's touch module.
# CONFIG_I2C_XILINX is not set
# no AXI Quad SPI or GPIO in the kernel's half of the map any more
# CONFIG_SPI_XILINX is not set
# CONFIG_GPIO_XILINX is not set
# NO FLASH STACK (ILA finding #24, 2026-09-24): something zeroed 13 bytes of the
# DUT's SST26 at 0x20000 and nobody knows what, so nothing in the harness may be
# able to program or erase it. rv32's defconfig turns MTD + MTD_SPI_NOR (and
# MTD_BLOCK/CFI) ON; the 2026-09-23 image still had them. "Is not set" here takes
# the whole MTD tree out; mps3_image.py kconfig-gate (build.sh step 6 and the
# post-build hook) refuses a kernel .config with MTD, MTD_SPI_NOR, SPI_XILINX or
# SPI_XILINX_QSPI set. DRIVER_MATRIX.md §2.6 is SUPERSEDED.
# CONFIG_MTD is not set
#
# Dropped 2026-09-23 (IMAGE lane): the July WAVE-4 eth0-diagnosis temporaries
# (DETECT_HUNG_TASK / 30 s / STACKTRACE — their own comment said "drop once
# the eth0 bring-up path is understood"; it is: the patch-0007 delay fix), and
# the FPGA manager/bridge/region core (only the legacy mps3_dfx.ko used it; it
# is in kernel_fragment_harness_legacy.config).
