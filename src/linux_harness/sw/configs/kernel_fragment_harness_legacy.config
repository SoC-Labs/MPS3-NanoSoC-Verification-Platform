# kernel_fragment_harness_legacy.config — the LEGACY variant only
# (build.sh MPS3_VARIANT=legacy): the v0.7 daemons + mps3_dfx.ko.
#
# mps3_dfx.ko compiles its fpga-mgr / fpga-bridge veneer in when CONFIG_FPGA=y
# (package/mps3-dfx: "This image's kernel has CONFIG_FPGA=y, so the veneer
# must be (re)compiled IN"). The default image has no in-kernel ICAP user
# (harnessd drives HWICAP through UIO), so it does not carry the FPGA core.
CONFIG_FPGA=y
CONFIG_FPGA_BRIDGE=y
CONFIG_FPGA_REGION=y
CONFIG_OF_FPGA_REGION=y
