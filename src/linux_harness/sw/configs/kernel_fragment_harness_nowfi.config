# kernel_fragment_harness_nowfi.config — busy-poll idle (patch 0002,
# RISCV_SOCLABS_NOWFI_IDLE). IN THE DEFAULT SET (build.sh MPS3_IDLE=nowfi).
#
# Every July silicon success ran a nowfi kernel (Image_nowfi / Image_irqfix):
# on the MBV a hart in WFI was never reliably woken, and the stable production
# login needed nowfi AND the In1 uartlite fix together. The C_INTERRUPT_WAKEUP=1
# static has not changed that verdict on silicon, so wfi idle is an explicit
# experiment (MPS3_IDLE=wfi), not the default.
#
# July trap this closes: mk_1region.sh re-applied the fragments WITHOUT this
# option, so the only 1-region blob ever built carried the wfi kernel.
#
# Cost: the idle loop spins (100 % CPU in `top`, no power saving); every wait is
# still interrupt-driven, so the single hart stays responsive.
CONFIG_RISCV_SOCLABS_NOWFI_IDLE=y
