 obj-$(CONFIG_RALINK_TIMER)		+= timer-ralink.o
 obj-$(CONFIG_NXP_STM_TIMER)		+= timer-nxp-stm.o
+obj-$(CONFIG_SOCLABS_MBV_TIMER)		+= timer-soclabs-mbv.o
diff -Naur a/drivers/clocksource/timer-soclabs-mbv.c b/drivers/clocksource/timer-soclabs-mbv.c
--- a/drivers/clocksource/timer-soclabs-mbv.c	1970-01-01 01:00:00.000000000 +0100
+++ b/drivers/clocksource/timer-soclabs-mbv.c	2026-07-17 10:32:13.715192686 +0100
@@ -0,0 +1,329 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * timer-soclabs-mbv.c - AXI Timer S-mode clockevent for the SoCLabs
+ * "linux_soc" platform (AMD MicroBlaze-V RV32 on Arm MPS3).
+ *
+ * Delivers the kernel tick from channel 0 of a Xilinx LogiCORE AXI Timer
+ * (PG079) as a normal S-mode external interrupt through the Xilinx AXI
+ * INTC (PG099): axi_timer -> axi_intc -> irq-xilinx-intc -> irq-riscv-intc.
+ *
+ * This is a silicon-errata workaround, not a general AXI Timer driver.
+ * The architected RISC-V S-mode timer path is unusable on this silicon
+ * (board evidence 2026-07-16, MPS3 KU115; full record and the path back
+ * to the architected timer in
+ * Documentation/devicetree/bindings/timer/soclabs,mbv-timer.yaml):
+ *
+ *  E1 "Sstc dead":    writing stimecmp never produces a deliverable
+ *                     S-mode timer interrupt, although the time counter
+ *                     (rdtime) runs correctly.
+ *  E2 "STIP sticky":  mip.STIP, once set from M-mode, can never be
+ *                     cleared again; an M-mode-injected STIP (the retired
+ *                     OpenSBI "plan C" workaround) therefore livelocks
+ *                     the kernel inside its timer interrupt handler.
+ *
+ * External-interrupt delivery and delegation are healthy on the same
+ * silicon (MEIP, SEIP, mideleg covers SEIE), so the tick is moved onto
+ * SEIP and the STIP machinery is bypassed entirely: this driver issues
+ * no SBI timer calls, no stimecmp access and no mip access. It ALSO
+ * registers a clocksource on timer channel 1 (silicon errata E4: rdtime
+ * freezes when the hart idles), replacing the frozen Zicntr rdtime as
+ * the ktime source; see mbv_clocksource_init() below.
+ *
+ * The ISR ack sequence (level-latch race, silicon-proven fix)
+ * -----------------------------------------------------------
+ * The INTC input is level-typed (C_KIND_OF_INTR=0): its ISR latch sets
+ * on every clock the synchronised input samples high, and clears only on
+ * an IAR write. handle_level_irq acks the INTC (IAR) BEFORE this handler
+ * runs, while T0INT still drives the request line high; between that
+ * early ack and the moment the handler's posted T0INT-clear write lands
+ * in the timer, the still-high line re-latches ISR. Left alone, the
+ * stale latch fires a spurious re-entry after the late level-flow
+ * unmask - and on real silicon that dance eventually wedged the tick
+ * engine (2026-07-16: ticks died ~33 s into boot, mid rcS).
+ *
+ * The fix is to make the source provably quiet and the latch provably
+ * clean before the handler returns:
+ *
+ *   1. W1C T0INT in TCSR0 and read TCSR0 back: the read forces the
+ *      posted write to land, so the request line is now provably low;
+ *   2. write this timer's bit to the INTC IAR to scrub the re-latched
+ *      stale ISR bit, and read the INTC back to post that write too.
+ *
+ * The late unmask then finds a clean latch: deterministically one
+ * interrupt per event (silicon-proven: 2500+ ticks, zero spurious).
+ * The extra IAR write W1Cs only this timer's own ISR bit, so the
+ * irqchip's bookkeeping is unaffected. A spurious-re-entry guard remains
+ * as a counted backstop.
+ *
+ * Binds only the "soclabs,mbv-timer" compatible; inert on any other
+ * device tree.
+ */
+
+#define pr_fmt(fmt) "soclabs-mbv-timer: " fmt
+
+#include <linux/clockchips.h>
+#include <linux/clocksource.h>
+#include <linux/init.h>
+#include <linux/interrupt.h>
+#include <linux/io.h>
+#include <linux/irq.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_irq.h>
+
+/* AXI Timer (PG079), channel 0 */
+#define MBV_TCSR0		0x00
+#define MBV_TLR0		0x04
+#define MBV_TCR0		0x08
+#define MBV_TCSR1		0x10
+#define MBV_TLR1		0x14
+#define MBV_TCR1		0x18
+
+#define MBV_TCSR_UDT		BIT(1)	/* count down */
+#define MBV_TCSR_ARHT		BIT(4)	/* auto reload */
+#define MBV_TCSR_LOAD		BIT(5)	/* load counter from TLR */
+#define MBV_TCSR_ENIT		BIT(6)	/* interrupt enable */
+#define MBV_TCSR_ENT		BIT(7)	/* counter enable */
+#define MBV_TCSR_TINT		BIT(8)	/* interrupt flag, W1C */
+
+/* AXI INTC (PG099) - only what the stale-latch scrub needs */
+#define MBV_INTC_ISR		0x00
+#define MBV_INTC_IAR		0x0c
+
+/* clockevents_config_and_register() limits, in timer ticks */
+#define MBV_MIN_DELTA		100
+#define MBV_MAX_DELTA		0xfffffffe
+
+static void __iomem *mbv_timer_base;
+static void __iomem *mbv_intc_base;	/* optional: stale-latch scrub */
+static u32 mbv_intc_ack_mask;
+static u32 mbv_timer_freq;
+static u32 mbv_timer_ticks;
+static u32 mbv_timer_spurious;
+
+static void mbv_timer_stop(void)
+{
+	/* ENT=0 stops the counter; TINT W1C clears any latched interrupt */
+	writel(MBV_TCSR_TINT, mbv_timer_base + MBV_TCSR0);
+}
+
+static int mbv_timer_set_next_event(unsigned long delta,
+				    struct clock_event_device *ce)
+{
+	mbv_timer_stop();
+	writel(delta, mbv_timer_base + MBV_TLR0);
+	writel(MBV_TCSR_UDT | MBV_TCSR_LOAD, mbv_timer_base + MBV_TCSR0);
+	/* one-shot: ARHT=0 holds the counter at terminal count */
+	writel(MBV_TCSR_UDT | MBV_TCSR_ENIT | MBV_TCSR_ENT,
+	       mbv_timer_base + MBV_TCSR0);
+	return 0;
+}
+
+static int mbv_timer_set_periodic(struct clock_event_device *ce)
+{
+	mbv_timer_stop();
+	writel(DIV_ROUND_CLOSEST(mbv_timer_freq, HZ),
+	       mbv_timer_base + MBV_TLR0);
+	writel(MBV_TCSR_UDT | MBV_TCSR_LOAD, mbv_timer_base + MBV_TCSR0);
+	writel(MBV_TCSR_UDT | MBV_TCSR_ARHT | MBV_TCSR_ENIT | MBV_TCSR_ENT,
+	       mbv_timer_base + MBV_TCSR0);
+	return 0;
+}
+
+static int mbv_timer_shutdown(struct clock_event_device *ce)
+{
+	mbv_timer_stop();
+	return 0;
+}
+
+static struct clock_event_device mbv_clockevent = {
+	.name			= "soclabs-mbv-timer",
+	.features		= CLOCK_EVT_FEAT_PERIODIC | CLOCK_EVT_FEAT_ONESHOT,
+	/* must outrank the riscv-timer (100), dead on this silicon */
+	.rating			= 300,
+	.set_next_event		= mbv_timer_set_next_event,
+	.set_state_periodic	= mbv_timer_set_periodic,
+	.set_state_shutdown	= mbv_timer_shutdown,
+	.set_state_oneshot_stopped = mbv_timer_shutdown,
+};
+
+static irqreturn_t mbv_timer_isr(int irq, void *dev_id)
+{
+	struct clock_event_device *ce = dev_id;
+	u32 tcsr = readl(mbv_timer_base + MBV_TCSR0);
+
+	if (!(tcsr & MBV_TCSR_TINT)) {
+		/*
+		 * Backstop only: a stale-latch re-entry that the scrub
+		 * below should have prevented. Count it, never
+		 * double-tick. Nonzero counts here mean the scrub is not
+		 * doing its job - see the header comment.
+		 */
+		if (!mbv_timer_spurious++)
+			pr_debug("spurious re-entry (stale INTC latch)\n");
+		return IRQ_NONE;
+	}
+
+	/* Steps 1 + 2 of the silicon-proven ack sequence (header comment) */
+	writel(tcsr | MBV_TCSR_TINT, mbv_timer_base + MBV_TCSR0);
+	(void)readl(mbv_timer_base + MBV_TCSR0);
+	if (mbv_intc_base) {
+		writel(mbv_intc_ack_mask, mbv_intc_base + MBV_INTC_IAR);
+		(void)readl(mbv_intc_base + MBV_INTC_ISR);
+	}
+
+	/*
+	 * Bring-up tripwires, quiet by default. "first tick" doubles as
+	 * the SEIP-delivery discriminator: if it never fires and boot
+	 * stalls tick-less, S-mode external interrupt taking is broken.
+	 */
+	mbv_timer_ticks++;
+	if (mbv_timer_ticks == 1)
+		pr_debug("first tick delivered via SEIP\n");
+	else if (mbv_timer_ticks == 2500)
+		pr_debug("2500 ticks, tick engine stable (spurious backstops: %u)\n",
+			 mbv_timer_spurious);
+
+	/* clockevent not registered yet: acked above, nothing to run */
+	if (likely(ce->event_handler))
+		ce->event_handler(ce);
+	return IRQ_HANDLED;
+}
+
+/*
+ * Map the parent AXI INTC (ack registers only) for the stale-latch scrub.
+ * Optional: without it the driver falls back to the spurious-re-entry
+ * backstop, which is known NOT to hold up on real silicon (see header) -
+ * hence the loud warning in the caller.
+ */
+static int __init mbv_timer_map_intc(struct device_node *np)
+{
+	struct device_node *parent;
+	u32 hwirq;
+
+	parent = of_irq_find_parent(np);
+	if (parent && parent != np)
+		mbv_intc_base = of_iomap(parent, 0);
+	of_node_put(parent);
+	if (!mbv_intc_base)
+		return -ENXIO;
+
+	if (of_property_read_u32_index(np, "interrupts", 0, &hwirq) ||
+	    hwirq >= 32) {
+		iounmap(mbv_intc_base);
+		mbv_intc_base = NULL;
+		return -EINVAL;
+	}
+
+	mbv_intc_ack_mask = BIT(hwirq);
+	return 0;
+}
+
+/*
+ * Clocksource on timer channel 1 (silicon errata E4, board evidence
+ * 2026-07-21): the RISC-V rdtime/Zicntr counter FREEZES whenever the hart
+ * is idle - it advances only while the core is actively clocked, so
+ * ktime_get() stalls at the first idle window and every hrtimer wakeup
+ * (usleep_range/nanosleep) hangs forever - even on the no-wfi idle path
+ * (Image_nowfi board test: uptime stuck at 55.86 across a 10.11 s gap).
+ *
+ * The AXI Timer's second counter is external fabric on shell_clk and keeps
+ * counting regardless of hart idle state, so it is a safe ktime source.
+ * Channel 1 runs as a free-running 32-bit UP counter (UDT=0), auto-
+ * reloading from TLR1=0 on rollover, interrupt disabled - mirroring the
+ * mainline Xilinx AXI-timer clocksource (arch/microblaze/kernel/timer.c
+ * xilinx_clocksource_init()). Registered at rating 450, above
+ * riscv_clocksource (400), so timekeeping selects it in place of the
+ * frozen rdtime. rdtime stays sched_clock (that path tolerates idle
+ * stalls); COUNT_WIDTH=32 in the BD, hence a 32-bit mask.
+ */
+static u64 mbv_clocksource_read(struct clocksource *cs)
+{
+	return readl(mbv_timer_base + MBV_TCR1);
+}
+
+static struct clocksource mbv_clocksource = {
+	.name	= "soclabs-mbv-timer-cs",
+	.rating	= 450,			/* > riscv_clocksource (400) */
+	.read	= mbv_clocksource_read,
+	.mask	= CLOCKSOURCE_MASK(32),	/* COUNT_WIDTH=32 in the BD */
+	.flags	= CLOCK_SOURCE_IS_CONTINUOUS,
+};
+
+static int __init mbv_clocksource_init(void)
+{
+	/* free-running up-counter (UDT=0), auto-reload from 0, no interrupt */
+	writel(0, mbv_timer_base + MBV_TLR1);
+	writel(MBV_TCSR_TINT, mbv_timer_base + MBV_TCSR1);
+	writel(MBV_TCSR_ENT | MBV_TCSR_ARHT, mbv_timer_base + MBV_TCSR1);
+	return clocksource_register_hz(&mbv_clocksource, mbv_timer_freq);
+}
+
+static int __init mbv_timer_init(struct device_node *np)
+{
+	int irq, ret;
+
+	mbv_timer_base = of_iomap(np, 0);
+	if (!mbv_timer_base) {
+		pr_err("%pOF: cannot map timer registers\n", np);
+		return -ENXIO;
+	}
+
+	ret = of_property_read_u32(np, "clock-frequency", &mbv_timer_freq);
+	if (ret || !mbv_timer_freq) {
+		pr_err("%pOF: missing or zero clock-frequency\n", np);
+		if (!ret)
+			ret = -EINVAL;
+		goto out_unmap;
+	}
+
+	irq = irq_of_parse_and_map(np, 0);
+	if (irq <= 0) {
+		pr_err("%pOF: cannot map interrupt\n", np);
+		ret = -EINVAL;
+		goto out_unmap;
+	}
+
+	ret = mbv_timer_map_intc(np);
+	if (ret)
+		pr_warn("%pOF: no INTC ack mapping (%d) - stale-latch scrub disabled, tick NOT board-safe\n",
+			np, ret);
+
+	/* quiesce both channels: M-mode firmware may have owned them */
+	writel(MBV_TCSR_TINT, mbv_timer_base + MBV_TCSR0);
+	writel(MBV_TCSR_TINT, mbv_timer_base + MBV_TCSR1);
+
+	ret = mbv_clocksource_init();
+	if (ret)
+		pr_warn("%pOF: clocksource register failed (%d) - ktime stays on frozen rdtime\n",
+			np, ret);
+
+	ret = request_irq(irq, mbv_timer_isr, IRQF_TIMER, "soclabs-mbv-timer",
+			  &mbv_clockevent);
+	if (ret) {
+		pr_err("%pOF: cannot request irq %d: %d\n", np, irq, ret);
+		goto out_dispose;
+	}
+
+	mbv_clockevent.cpumask = cpu_possible_mask;
+	mbv_clockevent.irq = irq;
+	clockevents_config_and_register(&mbv_clockevent, mbv_timer_freq,
+					MBV_MIN_DELTA, MBV_MAX_DELTA);
+
+	pr_info("tick on AXI timer @%u Hz, S-mode ext irq %d, latch scrub %s (Sstc/STIP errata bypassed)\n",
+		mbv_timer_freq, irq, mbv_intc_base ? "on" : "OFF");
+	return 0;
+
+out_dispose:
+	irq_dispose_mapping(irq);
+	if (mbv_intc_base) {
+		iounmap(mbv_intc_base);
+		mbv_intc_base = NULL;
+	}
+out_unmap:
+	iounmap(mbv_timer_base);
+	mbv_timer_base = NULL;
+	return ret;
+}
+
+TIMER_OF_DECLARE(soclabs_mbv_timer, "soclabs,mbv-timer", mbv_timer_init);
