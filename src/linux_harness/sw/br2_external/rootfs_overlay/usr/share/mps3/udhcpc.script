#!/bin/sh
#
# udhcpc.script — the lease half of S41mps3net (IMAGE_CONTRACT §5).
#
# Unlike Busybox's default script this NEVER flushes the interface or
# overwrites its primary address: it adds/removes only the address it was
# leased (remembered in /run/mps3/lease.$interface), so the permanent static
# secondary (the board identity's, /run/mps3/identity) survives every
# bound/renew/deconfig. It re-asserts it after a lease change
# (promote_secondaries keeps it in place anyway).

RUN=/run/mps3
LEASE=$RUN/lease.$interface
RESOLV=/etc/resolv.conf
mkdir -p "$RUN"

state() {
    touch "$RUN/net.state"
    sed -i "/^$1=/d" "$RUN/net.state"
    echo "$1=$2" >> "$RUN/net.state"
}

mask_bits() {   # dotted netmask -> prefix length
    n=0
    for o in $(echo "$1" | tr . ' '); do
        case $o in
            255) n=$((n + 8)) ;; 254) n=$((n + 7)) ;; 252) n=$((n + 6)) ;;
            248) n=$((n + 5)) ;; 240) n=$((n + 4)) ;; 224) n=$((n + 3)) ;;
            192) n=$((n + 2)) ;; 128) n=$((n + 1)) ;;
        esac
    done
    echo $n
}

drop_lease() {
    if [ -s "$LEASE" ]; then
        ip addr del "$(cat "$LEASE")" dev "$interface" 2>/dev/null
        rm -f "$LEASE"
    fi
    state dhcp 0
    state lease none
}

case "$1" in
    deconfig)
        ip link set "$interface" up
        drop_lease
        ;;
    leasefail|nak)
        ;;
    renew|bound)
        cidr="$ip/$(mask_bits "${subnet:-255.255.255.0}")"
        if [ "$(cat "$LEASE" 2>/dev/null)" != "$cidr" ]; then
            drop_lease
            ip addr add "$cidr" ${broadcast:+broadcast $broadcast} dev "$interface" \
                && echo "$cidr" > "$LEASE"
        fi
        if [ -n "$router" ]; then
            while ip route del default dev "$interface" 2>/dev/null; do :; done
            for r in $router; do
                ip route add default via "$r" dev "$interface" && break
            done
        fi
        if [ -n "$dns" ]; then
            {
                [ -n "$domain" ] && echo "search $domain"
                for d in $dns; do echo "nameserver $d"; done
            } > "$RESOLV"
        fi
        state dhcp 1
        state lease "$ip"
        # the permanent secondary, if it was ours before the lease moved
        if grep -q '^static101=added' "$RUN/net.state" 2>/dev/null; then
            . /etc/mps3/net.conf 2>/dev/null
            # the board identity owns the static address (S41mps3net, lane IDENT)
            MPS3_IP=
            [ -r "$RUN/identity" ] && . "$RUN/identity" 2>/dev/null
            [ -n "$MPS3_IP" ] && MPS3_NET_STATIC=$MPS3_IP
            [ -n "$MPS3_NET_STATIC" ] && ip addr add "$MPS3_NET_STATIC" dev "$interface" 2>/dev/null
        fi
        ;;
esac
exit 0
