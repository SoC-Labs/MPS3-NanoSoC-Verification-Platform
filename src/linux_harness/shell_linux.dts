		uio_dbgbr: dbgbr@44a80000 {
			compatible = "generic-uio";
			reg = <0x44a80000 0x10000>;
			linux,uio-name = "dbgbr";
		};

		/* UARTBR — fpga/shell/bd/shell_bd.tcl (uart_bridge_0). harnessd-owned. */
		uio_uartbr: uartbr@44a90000 {
