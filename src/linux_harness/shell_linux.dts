		/* TOUCH — fpga/shell/bd/touch_iic_add.tcl (touch_iic_0). harnessd-owned. GATED: built only with SHELL_TOUCH=1 (the MBV mint sets it). */
		uio_touch_iic: touch-iic@44ae0000 {
			compatible = "generic-uio";
			reg = <0x44ae0000 0x10000>;
			linux,uio-name = "touch-iic";
		};

		/* DUTEGR — fpga/shell/bd/shell_bd.tcl (dut_egress_0). harnessd-owned. */
		uio_dutegr: dutegr@44b20000 {
			compatible = "generic-uio";
			reg = <0x44b20000 0x10000>;
			linux,uio-name = "dutegr";
		};

		/* USRACC — fpga/shell/bd/shell_bd.tcl (usr_access_rd_0). harnessd-owned. */
		uio_usracc: usracc@44b30000 {
			compatible = "generic-uio";
			reg = <0x44b30000 0x10000>;
			linux,uio-name = "usracc";
		};

		/* WDOG — fpga/shell/bd/shell_bd.tcl (axi_timebase_wdt_0). harnessd-owned. */
		uio_wdog: wdog@44b40000 {
			compatible = "generic-uio";
			reg = <0x44b40000 0x10000>;
			linux,uio-name = "wdog";
		};

		/* LAN9220 behind the AXI EMC — fpga/shell/bd/shell_bd.tcl (axi_emc_0) (16 MiB decode; the chip
		 * aliases every 256 B).
		 * reg-io-width = <4>: the EMC assembles two 16-bit cycles into ONE 32-bit
		 *   AXI beat, exactly as the bare-metal driver reads it. <2> popped the RX
		 *   data FIFO twice per word and overran skbs into slab (the July 57 s
		 *   hrtimer oops). Do not change it.
		 * ETH_INT POLARITY TRIPLE (SHELL_CONTRACT §4; silicon 2026-07-19) — the
		 *   three ship together or eth0 up livelocks the kernel:
		 *   (1) NO smsc,irq-active-high / smsc,irq-push-pull here,
		 *   (2) PULLTYPE PULLUP on ETH_INT,
