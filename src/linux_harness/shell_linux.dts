			reg = <0xc0000000 0x10000>;
			interrupt-parent = <&axi_intc>;
			interrupts = <3 4>;
			reg-io-width = <4>;
			smsc,force-internal-phy;
			local-mac-address = [02 00 00 4D 50 53];
			vdd33a-supply = <&reg_3v3>;
			vddvario-supply = <&reg_3v3>;
			phy-mode = "mii";
		};
