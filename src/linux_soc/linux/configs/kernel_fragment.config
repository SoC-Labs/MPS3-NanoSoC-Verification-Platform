# Kernel config fragment merged on top of arch/riscv "rv32_defconfig"
# (= riscv defconfig + 32-bit.config).
#
# Purpose: make ONE kernel Image serve both boot targets --
#   (a) qemu-system-riscv32 -M virt   (the boot proof: ns16550 ttyS0, CLINT, PLIC, virtio)
#   (b) the real linux_soc MicroBlaze V SoC (uartlite ttyUL0, axi_intc)
# The rv32 defconfig already provides (a); this fragment adds the Xilinx AXI IP for (b).
# Both driver sets are compiled in; the DTB decides which ones actually probe.

# --- Xilinx AXI uartlite: the real SoC's console @0x40600000 -----------------
# Verified selectable on riscv: SERIAL_UARTLITE depends only on HAS_IOMEM.
CONFIG_SERIAL_UARTLITE=y
CONFIG_SERIAL_UARTLITE_CONSOLE=y
CONFIG_SERIAL_UARTLITE_NR_UARTS=1

# --- Xilinx AXI intc: the real SoC's interrupt controller @0x41200000 --------
# Verified selectable on riscv: XILINX_INTC depends only on OF_ADDRESS.
CONFIG_XILINX_INTC=y

# earlycon, so a board bring-up failure prints something before the real console
CONFIG_SERIAL_EARLYCON=y

# NOTE -- axi_timer (xlnx,xps-timer-1.00.a): there is deliberately NO CONFIG here.
# Mainline 6.18.7 has NO Xilinx AXI timer clocksource driver: drivers/clocksource
# contains zero xilinx files (include/clocksource/timer-xilinx.h exists only because
# drivers/pwm/pwm-xilinx.c shares the register defs). RISC-V Linux gets its timebase
# from the `time` CSR / SBI set_timer instead. See ../README.md "Timer + interrupt gap".

# --- plan-D (2026-07-16): S-mode clockevent on the AXI timer via SEIP --------
# Sstc STIP undeliverable AND mip.STIP stuck-once-set on this silicon (plan-C
# tripwire evidence). Driver added by patches/linux/0003; binds ONLY the
# "soclabs,mbv-timer" compatible that mk_dtb_pland.sh prepends to the timer
# node -- inert for qemu-virt and for every standard DTB.
CONFIG_SOCLABS_MBV_TIMER=y
