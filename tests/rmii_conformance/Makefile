# =============================================================================
# tests/rmii_conformance/Makefile  --  cross-implementation RMII conformance.
#
# Wires our shell-side rmii_phy_if back-to-back with the third-party MAC-side
# rmii_to_mii bridge and checks byte-exact recovery in both directions. See
# README.md for why this is a conformance check and not a self-check.
#
# Usage:
#   source <repo-root>/set_env.sh          # pins VCS 2022.06-SP2 (closes I24)
#   make -C tests/rmii_conformance SIM=vcs # default target: real + neg-control
#
# Self-contained pure-VCS flow (does NOT go through cocotb): the two DUTs are
# wired in SystemVerilog (rmii_conformance_tb.sv), so no Python driver is
# involved -- the stimulus and byte-exact checks live in the testbench.
#
# Targets:
#   all      (default) run the real conformance AND the negative control
#   real     compile+run the real back-to-back conformance -> run_real.log
#   neg      compile+run the negative control (swapped di-bit) -> run_neg.log
#   result   regenerate RESULT.txt from a fresh real+neg run
#   clean    remove all VCS artefacts (csrc/ simv* *.daidir *.log ucli.key ...)
# =============================================================================

SIM ?= vcs
ifneq ($(SIM),vcs)
$(error This bench is VCS-only (pure-SV, no cocotb). Got SIM=$(SIM); use SIM=vcs)
endif

# --- source locations (all READ-ONLY; nothing outside this dir is written) ---
THIS_DIR     := $(abspath $(CURDIR))
MPS3_ROOT    := $(abspath $(CURDIR)/../..)
RMII_PHY_IF  := $(MPS3_ROOT)/fpga/ethernet/rmii_phy_if/rmii_phy_if.sv
# Sibling repo (do NOT modify): override with ETH_MAC_AHB=... if it moves.
ETH_MAC_AHB  ?= $(abspath $(MPS3_ROOT)/../ethernet-mac-ahb)
RMII_TO_MII  := $(ETH_MAC_AHB)/amba_wb_bridges/src/rtl/rmii_to_mii.v

TB           := $(THIS_DIR)/rmii_conformance_tb.sv
NEG_PHY_IF   := $(THIS_DIR)/neg_control/rmii_phy_if_negctl.sv

VCS      := vcs
VCS_ARGS := -full64 -sverilog -timescale=1ns/1ps -notice -licqueue \
            +vcs+finish+500us -top rmii_conformance_tb

.PHONY: all real neg result clean

all: real neg neg-rx

# --- real back-to-back conformance ------------------------------------------
real:
	@echo "== building real conformance (rmii_phy_if <-> rmii_to_mii) =="
	$(VCS) $(VCS_ARGS) -o simv_real -l comp_real.log \
	    $(RMII_PHY_IF) $(RMII_TO_MII) $(TB)
	@echo "== running real conformance =="
	./simv_real -l run_real.log
	@echo "---- run_real.log (verdict line) ----"
	@grep -E "CONFORMANCE:|RESULT:" run_real.log || true

# --- negative control (deliberately swapped di-bit order on the PHY TX) ------
neg:
	@echo "== building negative control (swapped di-bit copy of rmii_phy_if) =="
	$(VCS) $(VCS_ARGS) -o simv_neg -l comp_neg.log \
	    $(NEG_PHY_IF) $(RMII_TO_MII) $(TB)
	@echo "== running negative control (EXPECT: CONFORMANCE: FAIL) =="
	./simv_neg -l run_neg.log
	@echo "---- run_neg.log (verdict line) ----"
	@grep -E "CONFORMANCE:|RESULT:" run_neg.log || true

neg-rx:
	@echo "== building negative control 2 (RX nibble halves swapped) =="
	$(VCS) $(VCS_ARGS) -o simv_neg_rx -l comp_neg_rx.log \
	    neg_control/rmii_phy_if_negctl_rx.sv $(RMII_TO_MII) $(TB)
	@echo "== running negative control 2 (EXPECT: Direction A FAILS) =="
	./simv_neg_rx -l run_neg_rx.log
	@grep -E "Direction A errors|CONFORMANCE:" run_neg_rx.log || true

# --- regenerate the committed RESULT.txt ------------------------------------
result: clean real neg
	@{ \
	  echo "RMII cross-implementation conformance -- VCS run transcript + verdict"; \
	  echo "Generated by: make -C tests/rmii_conformance result"; \
	  echo "VCS: $$(vcs -ID 2>/dev/null | head -1)"; \
	  echo; \
	  echo "############################################################"; \
	  echo "## REAL back-to-back: rmii_phy_if <-> rmii_to_mii         ##"; \
	  echo "############################################################"; \
	  cat run_real.log; \
	  echo; \
	  echo "############################################################"; \
	  echo "## NEGATIVE CONTROL: PHY TX di-bit order swapped          ##"; \
	  echo "## (proves the bench can fail; EXPECT CONFORMANCE: FAIL)  ##"; \
	  echo "############################################################"; \
	  cat run_neg.log; \
	} > RESULT.txt
	@echo "wrote RESULT.txt"

clean:
	rm -rf csrc simv_real simv_neg simv_neg_rx \
	       simv_real.daidir simv_neg.daidir simv_neg_rx.daidir \
	       *.log ucli.key vc_hdrs.h .vlogansetup.* AN.DB novas.* verdi* \
	       DVEfiles inter.vpd *.vpd
