# EXAMPLE ONLY -- not read by the harness.
#
# This is a verbatim copy of a rule file generated by
# ncompare/trace_compare.py:build_ncr(), captured from a run that nCompare
# accepted with zero rule errors ("100 <file> 0 0") and compared 2 signal pairs
# ("500 ... 2 0 0").  It is committed so the syntax can be reviewed without
# running anything.  The real one is generated per-run into
# build/compare_logs/iice_compare.ncr, with absolute FSDB paths.
#
# Invoked as:
#   nCompare -logdir <build>/compare_logs/nCompareLog \
#            -rule <this file> -report <...>.nce -silence
#
# Reminder: nCompare exits 0 even when it finds mismatches.  The verdict comes
# from the .nce "500" record, parsed by parse_nce().

cmpOpenFsdb /abs/path/build/compare_logs/ncmp_golden.fsdb /abs/path/build/compare_logs/ncmp_secondary.fsdb
cmpSetDelimiter .
# 0 == unlimited, so the reported totals are the real totals.
cmpSetCmpOption -maxerror 0 -maxerrorpersignal 0 -x T -z T
# ONE-WAY don't-care: sim(golden) X/Z vs hardware(secondary) 0/1 is a
# match; hardware X/Z against a known sim value is a MISMATCH.
cmpSetStateMap -asym (x,0,T) (x,1,T) (x,z,T) (0,x,F) (1,x,F) \
                     (z,0,T) (z,1,T) (z,x,T) (0,z,F) (1,z,F)
# The hardware-side rename lives HERE, generated from signal_map.tsv, because
# fsdbmangle cannot apply a rename map (it is an obfuscator -- see README.md).
# Golden names are the flat iice/* scope of INTERFACES.md §1; secondary names
# are the manifest hw_path with '/' -> '.' per cmpSetDelimiter.
cmpSetSignalPair {iice.haddr[3:0]} {rp_top.u_dut.HADDR[3:0]}
cmpSetSignalPair {iice.flag} {rp_top.u_dut.FLAG}
cmpCompare
