+### CoreSight SoC-400 system DAP (SWJ-DP + 2x AHB-AP) — SoC-400 baseline
+### integration (EXTERNAL_DAP=1). The SoC Labs wrapper set is carried into
+### this repo under src/rtl/coresight_soc400/ (see
+### integration/soc400/carry_manifest.md); the licensed Arm cxdapswjdp /
+### cxdapahbap cells are referenced IN PLACE from the read-only IP library
+### (this block is the Vivado-TCL translation of
+### coresight_soc400_{swjdp,ahbap}.flist). CARRY THE UNCONDITIONAL-CAPTURE
+### nanosoc_dbg_ahb_bridge.v — never the poll-gated single-AP variant.
+###=========================================================================
+set SOC400_RTL ${NANOSOC_SOC_DIR}/src/rtl/coresight_soc400
+set SOC400_IP  ${ARM_IP_LIBRARY_PATH}/SoC-400/coresight_soc/shared/logical
+
+# Arm SoC-400 AHB-AP (cxdapahbap) + generic CoreSight cells
+read_verilog [list \
+    ${SOC400_IP}/cxdapahbap/verilog/cxdapahbap.v \
+    ${SOC400_IP}/cxdapahbap/verilog/cxdapahbap_slv.v \
+    ${SOC400_IP}/cxdapahbap/verilog/cxdapahbap_mst.v \
+    ${SOC400_IP}/cxdapahbap/verilog/cxdapahbap_dap_sync.v \
+    ${SOC400_IP}/cxdapahbap/verilog/cxdapahbap_ahb_sync.v \
+    ${SOC400_IP}/models/cells/generic/cx_sync.v \
+    ${SOC400_IP}/models/cells/generic/cx_en_sync.v \
+    ${SOC400_IP}/models/cells/generic/cx_en_sync_high.v \
+    ${SOC400_IP}/models/cells/generic/cx_comb_mux2.v \
+]
+
+# Arm SoC-400 SWJ-DP (cxdapswjdp) + SWJ-DP-specific generic cells
+read_verilog [list \
+    ${SOC400_IP}/cxdapswjdp/verilog/cxdapswjdp.v \
+    ${SOC400_IP}/cxdapswjdp/verilog/cxdapswjdp_dapclk.v \
+    ${SOC400_IP}/cxdapswjdp/verilog/cxdapswjdp_dp_apb_sync.v \
+    ${SOC400_IP}/cxdapswjdp/verilog/cxdapswjdp_dp_i_mux.v \
+    ${SOC400_IP}/cxdapswjdp/verilog/cxdapswjdp_dp_or.v \
+    ${SOC400_IP}/cxdapswjdp/verilog/cxdapswjdp_jtag_dp_protocol.v \
+    ${SOC400_IP}/cxdapswjdp/verilog/cxdapswjdp_sw_dp_apb_if.v \
+    ${SOC400_IP}/cxdapswjdp/verilog/cxdapswjdp_sw_dp_protocol.v \
+    ${SOC400_IP}/cxdapswjdp/verilog/cxdapswjdp_sw_dp_sync.v \
+    ${SOC400_IP}/cxdapswjdp/verilog/cxdapswjdp_swclktck.v \
+    ${SOC400_IP}/cxdapswjdp/verilog/cxdapswjdp_swj_watcher.v \
+    ${SOC400_IP}/models/cells/generic/cxdapswjdp_clk_inverter.v \
+    ${SOC400_IP}/models/cells/generic/cxdapswjdp_dp_sync.v \
+]
+
+# SoC Labs SoC-400 wrapper set (carried from nanosoc-multicore-system).
+# nanosoc_dbg_ahb_bridge.v MUST be the multicore unconditional-capture version.
+read_verilog [list \
+    ${SOC400_RTL}/nanosoc_dap_ahb_xlate.v \
+    ${SOC400_RTL}/nanosoc_dap_ahb_arb.v \
+    ${SOC400_RTL}/nanosoc_dap_ss.v \
+    ${SOC400_RTL}/nanosoc_swj_dp_gate.v \
+    ${SOC400_RTL}/nanosoc_swj_dap_ss.v \
+    ${SOC400_RTL}/nanosoc_dbg_ahb_bridge.v \
+]
+
