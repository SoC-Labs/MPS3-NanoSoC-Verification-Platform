##############################################################################
# nanosoc_mps3.xdc -- monolithic nanoSoC-on-MPS3 baseline constraints
#
# Ported from the legacy single-core nanoSoC arm_mps3 FPGA target (2021.1):
#   nanosoc-multicore-system/nanosoc_arch_tech/fpga/fpga/targets/arm_mps3/
#     fpga_pinmap.xdc   (pin/IOSTANDARD/PULLUP assignments, MPS3 Rev-C SMM wrapper)
#     fpga_timing.xdc   (board input/output clocks)
# Target: Vivado 2024.1, part xcku115-flvb1760-1-c (Arm MPS3, Kintex UltraScale)
#
# Every pin/IOSTANDARD/PULLUP value below is copied verbatim from the legacy
# file (same PACKAGE_PIN letter-codes -- KU115 package pinout is unchanged
# between Vivado versions); only the ORGANIZATION changed: pins are grouped by
# board subsystem (matching nanosoc_design_wrapper.v's port list) with a
# provenance comment per group instead of the legacy file's single flat,
# alphabetically-interleaved list. No 2021.1->2024.1 XDC syntax is deprecated
# here (set_property/get_ports/create_clock/set_input_delay/set_output_delay
# are all unchanged); the only real port work is on the .tcl build script, see
# build_monolithic.tcl for the flagged deprecations there.
#
# Scope: this file constrains every port on nanosoc_design_wrapper.v (the
# legacy top). Most groups below (CLCD/HDMI/Audio/eMMC/MMB/QSPI/USD/shield)
# are DECLARED ports that the wrapper ties off or leaves unconnected -- nanosoc
# itself only drives/reads UART_TX_F[2]/UART_RX_F[2], OSCCLK[1] (ACLK), and
# CB_nRST/CS_nSRST (reset). They are constrained anyway because Vivado requires
# every top-level port to have a legal site/standard before bitstream generation
# on a board wrapper (SMM-style) target.
##############################################################################

#------------------------------------------------------------------------------
# LAN9220 Ethernet SMC interface (10/100, promiscuous on real HW)
# Provenance: fpga_pinmap.xdc lines ~37-39, ~319-321 (ETH_*); shares the SMBF_* static-memory-controller bus below
#------------------------------------------------------------------------------
set_property PACKAGE_PIN AL24 [get_ports ETH_nCS]
set_property IOSTANDARD LVCMOS18 [get_ports ETH_nCS]
set_property PACKAGE_PIN AJ23 [get_ports ETH_nOE]
set_property IOSTANDARD LVCMOS18 [get_ports ETH_nOE]
set_property PACKAGE_PIN AK23 [get_ports ETH_INT]
set_property IOSTANDARD LVCMOS18 [get_ports ETH_INT]

#------------------------------------------------------------------------------
