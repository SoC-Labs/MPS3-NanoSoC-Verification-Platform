# tools.env.example — copy to `tools.env` and edit. `tools.env` is NOT tracked.
#
# GNU make syntax (it is `-include`d by fpga/dfx/Makefile, fpga/rp/nanosoc_iice,
# firmware/micropython and firmware/qspi_loader, first, so these values win over
# the Makefiles' defaults while an explicit `make VAR=...` still wins over
# these). Plain `NAME = value` lines only: no `export`, no shell, no $(...) --
# set_env.sh and the build scripts (mk_toolchain_wrapper.sh, socscope_exp/
# build.sh, pin_nanosoc_snapshot.sh) read single keys from it with sed, and an
# exported environment variable of the same name always wins over this file.
#
# WHY THIS FILE EXISTS. A build that names one workstation's home directory is a
# build that works on exactly one machine and fails confusingly everywhere else
# -- and this repo is heading for a public release, where a baked hostname or
# /home/<someone> outlives the machine it described. The variables below have NO
# defaults in the Makefile for that reason: the mint refuses, by name, in
# seconds, instead of reading an empty or wrong source tree and dying inside
# Vivado four hours later.
#
# Nothing here is required for `make check` / `make check-ci`. It is needed to
# SYNTHESISE an RM or to run a mint.

# --- external source trees the RMs are built from (NOT vendored) -------------
# The nanoSoC single-core SoC checkout. rm_nanosoc / rm_nanosoc_upy read their
# RTL from it. It must be a checkout that HAS the confidential Arm SoC-400
# CoreSight DAP RTL under nanosoc_arch_tech/rtl/coresight_soc400_tech/rtl/ --
# a plain dev server does not, and the RM synth fails at that file.
# SOCLABS_NANOSOC_SOC_DIR = /path/to/nanosoc_m0_soc

# The AHB/APB QSPI flash controller repo. The SoC instantiates it
# unconditionally in the product configuration, so every nanosoc RM synth needs
# it on the environment.
# SOCLABS_AHB_QSPI_DIR = /path/to/ahb_qspi

# The multicore-ethernet DUT. rm_nanosoc_multicore sources its set_env.sh (which
# exports the ~14 read-only IP variables its filelist needs).
# NANOSOC_MULTICORE_HOME = /path/to/nanosoc-multicore-system

# The SoCScope checkout rm_socscope OOC-synthesises from ($SOCSCOPE_HOME/hw/rtl).
# Defaults to a sibling of this repo, which is usually right.
# SOCSCOPE_HOME = /path/to/SoCScope

# The shared Arm IP library (read-only, site-wide: Cortex-M0, CMSDK/BP210,
# OpenCores EthMAC/HA1588 ...). NO default: every RM synth that reads it, the
# monolithic flist (fpga/design.mk mps3-flist) and fpga/rp/eth_ss/filelist.tcl
# refuse by name without it. Never edit anything under it.
# ARM_IP_LIBRARY_PATH = /path/to/ip_library

# The ethernet-subsystem-ahb checkout rm_eth_ss wraps (fpga/rp/eth_ss/
# filelist.tcl). Only needed when the pre-produced eth_ss checkpoint is absent.
# ETH_SS_HOME = /path/to/ethernet-subsystem-ahb

# The standalone hostio4 checkout. tests/hostio4_golden takes the vendor
# testbench + stimulus + reference from $(HOSTIO4_HOME)/tb (the RTL under test
# still comes from SOCLABS_NANOSOC_SOC_DIR). Only that L0 bench needs it.
# HOSTIO4_HOME = /path/to/hostio4

# The nanosoc_tech checkout: fpga/rp/nanosoc/sw/socscope_exp/build.sh (software/)
# and the DDR4 pin generators src/linux_soc/hw/gen_pins.py + poc/ddr4_mbv/
# gen_pins.py (fpga/targets/arm_mps3/fpga_pinmap.xdc) read it.
# SOCLABS_NANOSOC_TECH_DIR = /path/to/nanosoc_tech

# --- toolchain ----------------------------------------------------------------
# VIVADO     = /path/to/Xilinx/Vivado/2024.1/bin/vivado
# VIVADO_VER = 2024.1
# UPDATEMEM  = /path/to/Xilinx/Vitis/2024.1/bin/updatemem
# MBNM       = /path/to/Xilinx/Vitis/2024.1/gnu/microblaze/lin/bin/mb-nm
# VITIS_SETTINGS = /path/to/Xilinx/Vitis/2024.1/settings64.sh

# The GNU Arm Embedded (arm-none-eabi) bin/ directory for the nanoSoC firmware
# (firmware/micropython, firmware/qspi_loader, socscope_exp). Empty = whatever
# arm-none-eabi-gcc is on PATH. The recorded image md5s were built with
# GNU Arm 10.3-2021.10.
# ARM_GCC_BIN = /path/to/gcc-arm-none-eabi-10.3-2021.10/bin

# The AMD rv32 glibc toolchain for the MicroBlaze V Linux image
# (src/linux_soc/linux/mk_toolchain_wrapper.sh, used by both Linux builds).
# Unset = derived from $XILINX_VIVADO (Vivado 2026.1 settings64.sh).
# MBV_LINUX_TOOLCHAIN = /path/to/Xilinx/Vivado/2026.1/gnu/riscv/linux_toolchain/lin32

# --- simulation (read by set_env.sh) -----------------------------------------
# bin/ of the Python 3.10 environment that holds cocotb 2.0.1 (put first on PATH).
# MPS3_PYTHON_BIN = /path/to/python3.10-env/bin
# Synopsys VCS install + licence server(s), e.g. port@host[:port@host].
# VCS_HOME = /path/to/synopsys/VCS_2022.06-SP2
# SNPSLMD_LICENSE_FILE = port@licence-host
# Questa fallback (appended to PATH) + its licence server.
# QUESTA_BIN = /path/to/questasim/linux_x86_64
# MGLS_LICENSE_FILE = port@licence-host

# --- where a copy of the irreplaceable mint artefacts goes --------------------
# An rsync destination -- `user@host:/path`, or a local path on another volume.
# THERE IS NO DEFAULT, and stage 8 of the mint is a no-op that says so until you
# set one. It matters more than it looks: static_routed_locked.dcp is the ONLY
# input from which a new overlay can ever be added to a fielded shell, it lives
# in a gitignored scratch tree, and until 2026-09-09 the fielded one existed in
# exactly one copy on one workstation. A `make clean` would have closed that
# shell permanently.
# MINT_HUB = user@host:/path/to/mint_archive
